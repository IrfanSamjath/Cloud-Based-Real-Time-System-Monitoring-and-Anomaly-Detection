# Copy this file to ".env" and fill in real values.
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (PowerShell)
#
# The real ".env" file is git-ignored (.gitignore) so secrets stay out of the repo.

# ---- InfluxDB (docker-compose.yml) ----
# Admin account used to bootstrap the InfluxDB container.
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change-me
DOCKER_INFLUXDB_INIT_ORG=telemetry-org
DOCKER_INFLUXDB_INIT_BUCKET=system-metrics
# API token the detector uses to write points. Rotate before production.
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=change-me

# ---- Grafana (docker-compose.yml) ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
# Allow anonymous read-only viewing of the dashboards.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# ---- Python services (services/producer & services/detector) ----
# Host-reachable addresses (change host if running inside Docker).
BROKER_URL=localhost:9092
KAFKA_TOPIC=system-metrics
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change-me
INFLUX_ORG=telemetry-org
INFLUX_BUCKET=system-metrics
