{
  "dashboard": {
    "uid": "samcloud-telemetry",
    "title": "Samcloud Telemetry Monitor",
    "tags": ["telemetry", "anomaly", "influxdb"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 0,
    "refresh": "5s",
    "time": { "from": "now-1h", "to": "now" },
    "templating": { "list": [] },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "CPU Usage (%) - prod-node-01",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
            "query": "from(bucket: \"system-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"server_telemetry\")\n  |> filter(fn: (r) => r._field == \"cpu_usage\")\n  |> filter(fn: (r) => r.host_id == \"prod-node-01\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent", "min": 0, "max": 100,
            "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "axisLabel": "CPU %" }
          },
          "overrides": []
        },
        "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "single" } }
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Request Latency (ms) - prod-node-01",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
            "query": "from(bucket: \"system-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"server_telemetry\")\n  |> filter(fn: (r) => r._field == \"latency_ms\")\n  |> filter(fn: (r) => r.host_id == \"prod-node-01\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms", "min": 0,
            "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "axisLabel": "Latency (ms)" }
          },
          "overrides": []
        },
        "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "single" } }
      },

      {
        "id": 3,
        "type": "timeseries",
        "title": "Anomaly Z-Score (threshold > 3.0)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
            "query": "from(bucket: \"system-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"server_telemetry\")\n  |> filter(fn: (r) => r._field == \"z_score\")\n  |> filter(fn: (r) => r.host_id == \"prod-node-01\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> yield(name: \"max\")"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "axisLabel": "Z-Score", "thresholdsStyle": { "mode": "line" } },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 3 } ] }
          },
          "overrides": []
        },
        "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max"] }, "tooltip": { "mode": "single" } }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Anomalies Detected (time range)",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
        "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
            "query": "from(bucket: \"system-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"server_telemetry\")\n  |> filter(fn: (r) => r._field == \"is_anomaly\")\n  |> filter(fn: (r) => r._value == 1)\n  |> count()"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
            "mappings": []
          },
          "overrides": []
        },
        "options": { "graphMode": "area", "colorMode": "background", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "Latest CPU Usage",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
        "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "eg10i38tp6c5cd" },
            "query": "from(bucket: \"system-metrics\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"server_telemetry\")\n  |> filter(fn: (r) => r._field == \"cpu_usage\")\n  |> filter(fn: (r) => r.host_id == \"prod-node-01\")\n  |> last()"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent", "min": 0, "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 } ] },
            "mappings": []
          },
          "overrides": []
        },
        "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
      }
    ]
  },
  "overwrite": true
}
